{
    "name": "mall-mystery-heroes",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "functions"
    ],
    "dependencies": {
        "@chakra-ui/icons": "^2.2.4",
        "@chakra-ui/react": "^2.8.2",
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.5",
        "@fontsource/montserrat": "^5.0.18",
        "@testing-library/jest-dom": "^5.17.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "firebase": "^10.12.0",
        "lucide-react": "^1.62.0",
        "mapbox-gl": "^3.32.0",
        "react": "^18.3.1",
        "react-autosuggest": "^10.1.0",
        "react-dom": "^18.3.1",
        "react-map-gl": "^7.1.9",
        "react-router-dom": "^6.23.1",
        "react-scripts": "^5.0.1",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "start": "craco start",
        "build": "craco build",
        "test": "jest --selectProjects unit dom",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:emulator": "node functions/scripts/sync-shared-game-logic.js && firebase emulators:exec --project demo-mall-mystery-heroes --only firestore,auth,functions,storage \"jest --selectProjects integration --runInBand\"",
        "test:rules": "firebase emulators:exec --project demo-mall-mystery-heroes --only firestore,storage \"jest --selectProjects rules --runInBand\"",
        "eject": "react-scripts eject",
        "lint": "eslint src --ext .js,.jsx --max-warnings=0",
        "lint:fix": "eslint src --ext .js,.jsx --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{json,md}\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{json,md}\" \"docs/**/*.md\"",
        "firebase:emulate": "node functions/scripts/sync-shared-game-logic.js && firebase emulators:start --project default"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-react": "^7.27.1",
        "@craco/craco": "^7.1.0",
        "@firebase/rules-unit-testing": "^3.0.4",
        "@svgr/webpack": "^8.1.0",
        "babel-jest": "^29.7.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.9.6",
        "react-test-renderer": "^18.3.1"
    }
}
